{
  "name": "playwright-practice",
  "private": true,
  "version": "1.0.0",
  "description": "Proyecto de practica para Playwright",
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && cp -r site/* dist/",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "codegen": "playwright codegen http://localhost:3000",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.10.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
